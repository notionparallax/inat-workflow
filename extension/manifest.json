{
  "manifest_version": 3,
  "name": "Dive iNat frame grabber",
  "version": "0.3.0",
  "description": "Reads frames from the YouTube player on the Dive iNat site, so you can turn dive videos into iNaturalist observations.",
  "homepage_url": "https://notionparallax.github.io/inat-workflow/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "all_frames": true,
      "js": [
        "grabber.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "all_frames": true,
      "js": [
        "main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
